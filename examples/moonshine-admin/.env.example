# ---------- SMF forum ----------
PHP_VERSION=8.2

SMF_VERSION=2.1.8

# Host ports for the forum (80/443 are often taken on dev machines by other stacks)
NGINX_HTTP_PORT=8085
NGINX_HTTPS_PORT=8443
# One-time install session port (compose.install.yaml)
NGINX_INSTALL_PORT=8000
FORUM_INSTALL_URL=http://localhost:8000

# RESTful API key (seeded into the forum, used with X-API-Key / Bearer header)
SMF_API_KEY=smf-dev-key-0001

DB_HOST=db
DB_USER=smf
DB_PASSWORD=pass
DB_NAME=smf
DB_PREFIX=smf_
DB_ROOT_PASSWORD=root

# Keep in sync with NGINX_HTTPS_PORT
FORUM_URL=https://localhost:8443
FORUM_NAME=My Community
FORUM_LANG=english
FORUM_LOGIN=Test
FORUM_PASS=test
FORUM_EMAIL=test@test.com

# ---------- MoonShine V (https://github.com/moonshine-software/v) ----------
# Tag of https://github.com/moonshine-software/v used to build the image
MSV_VERSION=v1.0.0

MSV_APP_PORT=8080
MSV_APP_URL=https://localhost:8080

MSV_DB_HOST=postgres
MSV_DB_DATABASE=moonshine_v
MSV_DB_USERNAME=moonshine_v
MSV_DB_PASSWORD=moonshine_v

MSV_ADMIN_NAME=Administrator
MSV_ADMIN_EMAIL=admin@localhost
MSV_ADMIN_PASSWORD=change-me

# MoonShine V must be able to reach the forum API inside the compose network
API_ADMIN_ALLOW_PRIVATE_UPSTREAM=true

ADMINER_PORT=8082
