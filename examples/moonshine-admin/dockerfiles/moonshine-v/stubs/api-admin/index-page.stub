<?php

declare(strict_types=1);

namespace {{ namespace }};

use MoonShine\Contracts\UI\FieldContract;
use App\ApiAdmin\Pages\RestIndexPage as IndexPage;
use {{ resourceNamespace }}\{{ resourceClass }};
{{ useStatements }}

/**
 * @extends IndexPage<{{ resourceClass }}>
 */
final class {{ className }} extends IndexPage
{
    protected bool $isLazy = true;

    /**
     * @return list<FieldContract>
     */
    protected function fields(): iterable
    {
        return \App\ApiAdmin\Resources\SmfPageFields::index($this, [
{{ indexFields }}
        ]);
    }

    /**
     * @return list<FieldContract>
     */
    protected function filters(): iterable
    {
        return [
{{ filterFields }}
        ];
    }

    protected function modifyListComponent(\MoonShine\Contracts\UI\ComponentContract $component): \MoonShine\Contracts\UI\ComponentContract
    {
        $endpoint = \App\ApiAdmin\Resources\SmfPageFields::endpoint($this->getResourceOrFail());

        if (! in_array($endpoint, ['/categories', '/boards'], true)) {
            return $component;
        }

        return \App\ApiAdmin\Pages\RestReorder::make(
            $this,
            grouped: $endpoint === '/boards',
        )->modifyListComponent($component);
    }

    #[\MoonShine\Support\Attributes\AsyncMethod]
    public function reorder(): \MoonShine\Crud\JsonResponse
    {
        $endpoint = \App\ApiAdmin\Resources\SmfPageFields::endpoint($this->getResourceOrFail());

        if (! in_array($endpoint, ['/categories', '/boards'], true)) {
            throw new \RuntimeException('Reordering is only available for categories and boards');
        }

        return \App\ApiAdmin\Pages\RestReorder::make(
            $this,
            grouped: $endpoint === '/boards',
        )->handle();
    }
}
